# ════════════════════════════════════════════════════════════════════
#  SeptroSchool — Backend Environment Configuration
#  Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════════════════════

APP_NAME="SeptroSchool"
APP_ENV=production
DEBUG=false
SECRET_KEY=change-this-to-a-random-64-char-secret-key

DATABASE_URL=postgresql+asyncpg://sms_user:sms_pass@localhost:5432/sms_db

# Redis + Celery power the async notification pipeline (delivery + scheduled sends).
# These MUST be enabled for SMS/WhatsApp/Email/Push delivery and beat schedules.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

ALLOWED_ORIGINS=["https://yourdomain.com"]
FRONTEND_URL=https://yourdomain.com

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set this to enable POST /api/v1/install (clear after install)
INSTALL_SECRET_KEY=my-install-secret-123

SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=Change@Me123!

STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── Email (SMTP) — global fallback; schools can override in Settings ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME="SeptroSchool"
SMTP_FROM_EMAIL=noreply@yourdomain.com
# The email tasks read MAIL_* first; set these (or leave blank to use SMTP_* above)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME="SeptroSchool"
MAIL_TLS=true

# ── SMS (global fallback; schools can override in Settings) ──
SMS_PROVIDER=msg91          # msg91 | twilio
MSG91_API_KEY=
MSG91_SENDER=SCHOOL
MSG91_TEMPLATE_ID=          # DLT flow/template id (required for India transactional SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── WhatsApp (Meta Cloud API) ──
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=sms_whatsapp_verify
META_WHATSAPP_API_VERSION=v18.0

# ── Push notifications ──
# Web Push (VAPID): generate a keypair, e.g. `python -m py_vapid --gen`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com
# Mobile (Expo) — access token optional; Firebase for FCM (optional)
EXPO_ACCESS_TOKEN=
FIREBASE_PROJECT_ID=

LLM_PROVIDER=none
