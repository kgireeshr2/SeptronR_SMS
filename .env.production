# Production database = PostgreSQL (Aiven). Replace with the real Aiven connection string.
# Must use the asyncpg driver. Aiven requires SSL — keep ?sslmode=require.
DATABASE_URL=postgresql+asyncpg://AVNADMIN:CHANGE_ME@PROJECT.aivencloud.com:PORT/defaultdb?sslmode=require
APP_ENV=production
DEBUG=False
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-secure-random-string-min-32-chars
# Redis powers login rate-limiting, token blacklist/logout and OTP login.
# With it OFF, those protections are silently inactive and OTP login returns 503.
# Provision a managed Redis and set the URLs below, then flip this to True.
REDIS_ENABLED=False
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
FRONTEND_URL=https://smsapi.septronr.com
BACKEND_URL=https://septronr-sms.onrender.com
