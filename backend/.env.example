# ════════════════════════════════════════════════════════════════════
#  School Management System — Backend Environment Configuration
#  Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════════════════════

APP_NAME="School Management System"
APP_ENV=production
DEBUG=false
SECRET_KEY=change-this-to-a-random-64-char-secret-key

DATABASE_URL=postgresql+asyncpg://sms_user:sms_pass@localhost:5432/sms_db

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

ALLOWED_ORIGINS=["https://yourdomain.com"]
FRONTEND_URL=https://yourdomain.com

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set this to enable POST /api/v1/install (clear after install)
INSTALL_SECRET_KEY=my-install-secret-123

SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=Change@Me123!

STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME="School SMS"
SMTP_FROM_EMAIL=noreply@yourdomain.com

LLM_PROVIDER=none
